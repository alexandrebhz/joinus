# Backend API base URL (protocol + host only, no trailing path)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public site URL (used for SEO / canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only shared secret for SSR → API (must match backend API_INTERNAL_KEY; never NEXT_PUBLIC_)
API_INTERNAL_KEY=

# Required to call POST /api/indexnow (header: x-indexnow-secret)
INDEXNOW_SECRET=

# Optional override for IndexNow key file name (public/{key}.txt)
# INDEXNOW_KEY=
