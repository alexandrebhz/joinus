# Environment
ENVIRONMENT=development
PORT=8080
GIN_MODE=debug

# Database
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=startup_board
# Use require/verify-full for remote Postgres
DB_SSL_MODE=disable

# JWT (production requires >= 32 chars; never use the example defaults)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Comma-separated CIDRs/IPs of reverse proxies allowed to set X-Forwarded-For
# Leave empty to ignore client-supplied forwarding headers
TRUSTED_PROXIES=

# Storage (minio | s3)
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=startup-board-uploads
MINIO_USE_SSL=false
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email
RESEND_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LIST_REQUESTS=30
RATE_LIMIT_DETAIL_REQUESTS=60
RATE_LIMIT_TRUSTED_REQUESTS=300

# Shared secret for Next.js SSR → API (must match frontend API_INTERNAL_KEY; never NEXT_PUBLIC_)
API_INTERNAL_KEY=

# Frontend URL, used for redirects (e.g. Stripe Checkout success/cancel)
APP_URL=http://localhost:3000

# Stripe billing
# Job Boost (one-time, EUR 49) -> boosts a job listing for 30 days
# Startup Pro (subscription, EUR 99/mo) -> unlocks Startup Pro plan
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_JOB_BOOST=price_...
STRIPE_PRICE_STARTUP_PRO=price_...

# OAuth (Google first; Apple/GitHub stubs return 501)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080/api/v1/auth/oauth
